# Vellum configuration — copy to .env and uncomment what you need.
# Never commit .env — it is in .gitignore.
#
# Everything below is commented out on purpose, so `cp .env.example .env` on its
# own changes nothing. Uncomment a line only when you are giving it a value:
# an empty `FOO=` is a value, not an absence.
#
# Nothing here is required. Hierarchy, provenance, and `generation register`
# (inbound) all work with no credentials at all. Add a provider key only when
# you want Vellum to submit generations for you.

# ─────────────────────────────────────────────────────────────────────────────
# Providers — set any subset. Vellum builds every backend it finds credentials
# for. `generation submit` takes an optional `provider`; status, reproduce and
# download route back to whichever provider produced each version.
# ─────────────────────────────────────────────────────────────────────────────

# ComfyUI Cloud (graph backend — submits workflow JSON).
# Generate at https://platform.comfy.org (API keys section).
# COMFYUI_API_KEY=
# Override for a self-hosted tenant. Default: https://cloud.comfy.org
# COMFYUI_API_BASE=
# Extra hosts accepted as signed-URL 302 targets, comma-separated. The built-in
# list already covers cloud.comfy.org, googleapis.com, amazonaws.com and
# r2.cloudflarestorage.com. Any host added here is still refused if it resolves
# to a private or loopback address.
# COMFYUI_ALLOWED_REDIRECT_HOSTS=

# Replicate (URL poll)
# REPLICATE_API_TOKEN=
# REPLICATE_API_BASE=
# REPLICATE_ALLOWED_OUTPUT_HOSTS=

# FAL (URL queue)
# FAL_KEY=
# FAL_API_BASE=
# FAL_ALLOWED_OUTPUT_HOSTS=

# BytePlus / ModelArk (async task)
# BYTEPLUS_API_KEY=
# BYTEPLUS_API_BASE=
# BYTEPLUS_ALLOWED_OUTPUT_HOSTS=

# Google AI Studio — Gemini / Nano Banana (inline base64). Either name works.
# GOOGLE_AI_STUDIO_API_KEY=
# GEMINI_API_KEY=
# GOOGLE_AI_STUDIO_API_BASE=

# Which provider an unqualified `generation submit` uses. Must be one of:
# comfyui-cloud, replicate, fal, byteplus, google-ai-studio — and must have
# credentials set, or the server refuses to start. Unset: the sole configured
# provider, else comfyui-cloud, else the first one found.
# DEFAULT_PROVIDER=

# ─────────────────────────────────────────────────────────────────────────────
# Spend controls
# ─────────────────────────────────────────────────────────────────────────────

# Human approval in front of every paid call. OFF unless set to 1/true/yes/on.
# With it on, `submit` / `reproduce` / `iterate` stop spending directly; a human
# approves each proposal first. Recommended for any deployment an agent drives.
# VELLUM_REQUIRE_APPROVAL=

# Refuse new generations while this many are already in flight. Unset = no cap.
# VELLUM_MAX_INFLIGHT_GENERATIONS=

# Refuse new generations once RECORDED spend in a rolling window reaches this
# amount. Only counts what `generation record_cost` was told, so it is a
# backstop against runaway loops, not a billing guarantee.
# VELLUM_SPEND_LIMIT=
# ISO currency for the limit above. Default: USD
# VELLUM_SPEND_LIMIT_CURRENCY=
# Rolling window in hours. Default: 24
# VELLUM_SPEND_LIMIT_WINDOW_HOURS=

# ─────────────────────────────────────────────────────────────────────────────
# Storage
# ─────────────────────────────────────────────────────────────────────────────

# SQLite database file. Default: vellum.db next to the package, NOT the current
# working directory — so an MCP client that launches the server from / still
# opens the same database as the dashboard. `--db` overrides this.
# VELLUM_DB_PATH=
# Where generated assets are written. Default: outputs
# VELLUM_OUTPUTS_DIR=
# Optional model directory scanned for the model fingerprint.
# VELLUM_MODELS_DIR=

# ─────────────────────────────────────────────────────────────────────────────
# HTTP surface (only used with --http)
# ─────────────────────────────────────────────────────────────────────────────

# Browser origins allowed to call the HTTP surface, comma-separated. Non-browser
# MCP clients (Claude Desktop, Cursor, CLI) send no Origin header and are always
# allowed — this guard only fires for browser tabs.
# Example: HTTP_ALLOWED_ORIGINS=http://localhost:5173,https://dash.example.com
# HTTP_ALLOWED_ORIGINS=
# Host header values accepted, comma-separated. This is the DNS-rebinding guard
# — a browser on a hostile page resolving to 127.0.0.1 is rejected here.
# Unset: localhost and 127.0.0.1 on the configured port.
# HTTP_ALLOWED_HOSTS=

# ─────────────────────────────────────────────────────────────────────────────
# Inbound ingest — `generation register` fetching an output by URL
# ─────────────────────────────────────────────────────────────────────────────

# Extra hosts an external agent or webhook may report outputs from, comma-
# separated, added to the built-in delivery hosts. As with the provider
# allowlists, a host here is still refused if it resolves to a private address.
# VELLUM_INGEST_ALLOWED_HOSTS=
# Per-output byte cap for URL fetches and direct-bytes uploads. Default: 500 MB
# VELLUM_INGEST_MAX_BYTES=
# Shared secret required on the ingest HTTP route. Leave empty to disable.
# VELLUM_INGEST_TOKEN=
# Abort a download stalled with no bytes for this long. Default: 60000
# VELLUM_DOWNLOAD_IDLE_TIMEOUT_MS=

# ─────────────────────────────────────────────────────────────────────────────
# C2PA signing — off unless BOTH a cert and a key are set
# ─────────────────────────────────────────────────────────────────────────────

# VELLUM_C2PA_CERT_PEM_PATH=
# VELLUM_C2PA_PRIVATE_KEY_PEM_PATH=
# Directory the cert and key files must live under — a path-containment check,
# not a trust anchor. Default: the current working directory.
# VELLUM_C2PA_CERT_ROOT=
# Accept the self-signed cert from scripts/gen-dev-c2pa-cert.mts. Development
# only — a manifest signed with it means nothing to anyone else.
# VELLUM_C2PA_TRUST_DEV_CERT=
# RFC 3161 timestamp authority, so signatures outlive the certificate.
# VELLUM_C2PA_TSA_URL=

# ─────────────────────────────────────────────────────────────────────────────
# Optional
# ─────────────────────────────────────────────────────────────────────────────

# Anthropic key for generated shot summaries. Without it, summaries fall back to
# a deterministic template — the feature works, it just does not use a model.
# ANTHROPIC_API_KEY=

# Concurrent ComfyUI status pollers. Clamped to 1..20. Default: 3
# COMFYUI_MAX_CONCURRENT_POLLS=

# Escape hatches for local development against a plain-HTTP or private-network
# ComfyUI. Both weaken a deliberate startup check — do not set in production.
# COMFYUI_API_BASE_ALLOW_HTTP=
# COMFYUI_API_BASE_ALLOW_PRIVATE=
